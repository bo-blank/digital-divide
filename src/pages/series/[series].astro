---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { getAllSeries, getPostsBySeries } from '../../lib/content-utils';
import { slugify } from '../../lib/slugify';

export const getStaticPaths = (async () => {
  const allSeries = await getAllSeries();

  // The slug goes in the URL; the original frontmatter string rides along as a
  // prop so the page can show "Future of Work" rather than re-title-casing
  // "future-of-work" and guessing at the author's capitalisation.
  return allSeries.map((series) => ({
    params: { series: slugify(series) },
    props: { seriesName: series },
  }));
}) satisfies GetStaticPaths;

const { series } = Astro.params;
const { seriesName } = Astro.props;
const posts = await getPostsBySeries(series);

// Sort by publish date (oldest first for series)
posts.sort((a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf());

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const seriesTitle = seriesName;
---

<BaseLayout
  title={`${seriesTitle} Series`}
  description={`A multi-part series exploring ${seriesTitle.toLowerCase()}.`}
>
  <section class="py-12 sm:py-16">
    <Container>
      <header class="mb-12">
        <p class="text-sm uppercase tracking-wide text-base-content/60 mb-2">
          Series
        </p>
        <h1 class="text-3xl sm:text-4xl font-heading font-normal tracking-tight">
          {seriesTitle}
        </h1>
        <p class="mt-3 text-base-content/70">
          {posts.length} {posts.length === 1 ? 'part' : 'parts'} in this series
        </p>
      </header>

      {posts.length > 0 ? (
        <ol class="space-y-6" role="list">
          {posts.map((post, index) => (
            <li class="relative pl-12 pb-6 border-l-2 border-base-300 last:border-l-0 last:pb-0">
              {/* Part number indicator */}
              <div class="absolute left-0 -translate-x-1/2 w-8 h-8 rounded-full bg-primary text-primary-content flex items-center justify-center text-sm font-medium">
                {index + 1}
              </div>

              <article class="group">
                <a href={`/blog/${post.id}`} class="block">
                  <h2 class="font-heading font-medium text-xl group-hover:text-primary transition-colors">
                    {post.data.title}
                  </h2>
                </a>
                <p class="mt-2 text-base-content/70 line-clamp-2">
                  {post.data.description}
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-base-content/60">
                  <time datetime={post.data.publishDate.toISOString()}>
                    {formatDate(post.data.publishDate)}
                  </time>
                </div>
                {post.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <a href={`/tags/${tag}`} class="text-xs">
                        {tag}
                      </a>
                    ))}
                  </div>
                )}
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <p class="text-base-content/70 text-center py-12">
          No posts in this series yet.
        </p>
      )}

      <div class="mt-12 pt-8 border-t border-base-300">
        <a href="/series" class="text-primary hover:underline">
          &larr; All series
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
