---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageBanner from '../components/PageBanner.astro';
import { mdxComponents } from '../components/mdx/components';
import aboutImage from '../assets/covers/divide-gap-person.jpg';

// The prose lives in src/content/pages/about.mdx so it can be edited in
// Keystatic (singletons.about). This file owns the chrome only.
const page = await getEntry('pages', 'about');

if (!page) {
  throw new Error(
    'Missing src/content/pages/about.mdx — /about renders its prose from the `pages` collection.'
  );
}

const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageBanner>
    <h1 class="text-3xl sm:text-4xl font-heading font-normal tracking-tight text-accent-content">
      {page.data.title}
    </h1>
    {page.data.tagline && (
      <p class="text-accent-content/90">{page.data.tagline}</p>
    )}
  </PageBanner>

  <section class="py-12 sm:py-16">
    <Container narrow>
      <div class="w-full h-64 sm:h-80 mb-8 overflow-hidden relative bg-base-300 animate-pulse">
        <Image
          src={aboutImage}
          alt="Person standing at a digital divide, representing the intersection of technology and humanity"
          class="absolute bottom-0 w-full h-[200%] object-cover object-bottom"
          loading="eager"
          onload="this.parentElement.classList.remove('bg-base-300', 'animate-pulse')"
        />
      </div>
      <div class="prose prose-lg max-w-none">
        {page.data.lead && (
          <p class="text-xl text-base-content/70 leading-relaxed">
            {page.data.lead}
          </p>
        )}
        <Content components={mdxComponents} />
      </div>
    </Container>
  </section>
</BaseLayout>
