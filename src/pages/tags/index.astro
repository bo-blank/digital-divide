---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import HeroImage from '../../components/HeroImage.astro';
import { getPublishedPosts } from '../../lib/content-utils';

const posts = await getPublishedPosts();

// Collect all tags with their post counts
const tagCounts = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

// Sort tags alphabetically
const sortedTags = Array.from(tagCounts.entries()).sort((a, b) =>
  a[0].localeCompare(b[0])
);
---

<BaseLayout
  title="Tags"
  description="Browse all topics and tags on Digital Divide."
>
  <HeroImage
    src="https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?w=1600&h=600&fit=crop"
    alt="Books and organized items representing topics and categories"
  >
    <h1 class="text-3xl sm:text-4xl font-heading font-normal tracking-tight text-base-content">
      Tags
    </h1>
    <p class="mt-3 text-base text-base-content/80">
      Browse essays by topic.
    </p>
  </HeroImage>

  <section class="py-12 sm:py-16">
    <Container>
      {sortedTags.length > 0 ? (
        <div class="flex flex-wrap gap-3">
          {sortedTags.map(([tag, count]) => (
            <a
              href={`/tags/${tag}`}
              class="flex items-center gap-2"
            >
              <span>{tag}</span>
              <span class="text-xs opacity-60">({count})</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-base-content/70 text-center py-12">
          No tags yet.
        </p>
      )}
    </Container>
  </section>
</BaseLayout>
