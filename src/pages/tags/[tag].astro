---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { getPublishedPosts, getPublishedNotes } from '../../lib/content-utils';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const notes = await getPublishedNotes();

  // Collect all unique tags from both posts and notes
  const tags = new Set<string>();
  posts.forEach((post) => {
    post.data.tags.forEach((tag: string) => tags.add(tag));
  });
  notes.forEach((note) => {
    note.data.tags?.forEach((tag: string) => tags.add(tag));
  });

  // Create a page for each tag with its filtered posts and notes
  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) =>
        post.data.tags.map((t: string) => t.toLowerCase()).includes(tag.toLowerCase())
      ),
      notes: notes.filter((note) =>
        note.data.tags?.map((t: string) => t.toLowerCase()).includes(tag.toLowerCase())
      ),
    },
  }));
}

interface Props {
  tag: string;
  posts: Awaited<ReturnType<typeof getPublishedPosts>>;
  notes: Awaited<ReturnType<typeof getPublishedNotes>>;
}

const { tag, posts, notes } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function formatTagDisplay(tag: string): string {
  // Convert underscores and hyphens to spaces and capitalize each word
  return tag
    .split(/[_-]/)
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}
---

<BaseLayout
  title={`Posts tagged "${tag}"`}
  description={`All content tagged with "${tag}" on Digital Divide.`}
>
  <section class="py-12 sm:py-16">
    <Container>
      <header class="mb-12">
        <a
          href="/tags"
          class="text-sm text-base-content/70 hover:text-primary transition-colors"
        >
          &larr; All tags
        </a>
        <h1 class="mt-4">
          Tagged: <span class="text-accent font-semibold">{formatTagDisplay(tag)}</span>
        </h1>
        <p class="mt-2 text-base-content/70">
          {posts.length} {posts.length === 1 ? 'essay' : 'essays'}
          {notes.length > 0 && (
            <span> &middot; {notes.length} {notes.length === 1 ? 'note' : 'notes'}</span>
          )}
        </p>
      </header>

      {posts.length === 0 && notes.length === 0 ? (
        <p class="text-base-content/70 text-center py-12">
          No content with this tag yet.
        </p>
      ) : (
        <div class="grid lg:grid-cols-2 gap-12">
          <!-- Essays Column -->
          <div>
            <h2 class="text-2xl font-heading font-normal mb-6 pb-2 border-b border-base-300">
              Essays
            </h2>
            {posts.length > 0 ? (
              <div class="space-y-6">
                {posts.map((post) => (
                  <article class="group">
                    <a href={`/blog/${post.id}`} class="block">
                      <h3 class="text-lg font-semibold group-hover:text-primary transition-colors">
                        {post.data.title}
                      </h3>
                      <p class="mt-2 text-base-content/70 line-clamp-2 text-sm">
                        {post.data.description}
                      </p>
                      <div class="mt-3 flex items-center gap-2 text-xs text-base-content/70">
                        <time datetime={post.data.publishDate.toISOString()}>
                          {formatDate(post.data.publishDate)}
                        </time>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            ) : (
              <p class="text-base-content/60 text-sm italic">No essays with this tag yet.</p>
            )}
          </div>

          <!-- Notes Column -->
          <div>
            <h2 class="text-2xl font-heading font-normal mb-6 pb-2 border-b border-base-300">
              Notes
            </h2>
            {notes.length > 0 ? (
              <div class="space-y-6">
                {notes.map((note) => (
                  <article class="group">
                    <a href={`/notes/${note.id}`} class="block">
                      {note.data.title ? (
                        <h3 class="text-lg font-semibold group-hover:text-primary transition-colors">
                          {note.data.title}
                        </h3>
                      ) : (
                        <p class="text-base-content/70 group-hover:text-primary transition-colors">
                          View note &rarr;
                        </p>
                      )}
                      <div class="mt-2 text-xs text-base-content/70">
                        <time datetime={note.data.publishDate.toISOString()}>
                          {formatDate(note.data.publishDate)}
                        </time>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            ) : (
              <p class="text-base-content/60 text-sm italic">No notes with this tag yet.</p>
            )}
          </div>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>
