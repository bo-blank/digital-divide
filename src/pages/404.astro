---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { getPublishedPosts } from '../lib/content-utils';

const recentPosts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout
  title="Page Not Found"
  description="That page doesn't exist. Browse the latest essays instead."
>
  <section class="py-16 sm:py-24">
    <Container narrow>
      <header class="mb-10">
        <p class="font-ui text-sm uppercase tracking-widest text-base-content/60">
          Error 404
        </p>
        <h1 class="mt-3">This page doesn't exist</h1>
        <p class="mt-4 text-lg text-base-content/70">
          The link may be out of date, or the address may have a typo.
        </p>
      </header>

      <div class="flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Go home</a>
        <a href="/blog" class="btn btn-outline btn-primary">Browse essays</a>
      </div>

      {recentPosts.length > 0 && (
        <div class="mt-14 border-t border-base-300 pt-8">
          <h2 class="text-xl">Recent essays</h2>
          <ul class="mt-4 space-y-3">
            {recentPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}`} class="text-primary hover:underline">
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>
