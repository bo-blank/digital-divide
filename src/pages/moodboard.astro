---

<BaseLayout title="Moodboard (Dev Only)" description="Image selection moodboard for Digital Divide">
  <Container class="py-8">
    <div class="mb-8">
      <h1 class="font-heading text-5xl font-normal tracking-tight leading-[1.1] mb-4">
        Essay Image Moodboard
      </h1>
      <p class="text-lg text-base-content/70 max-w-2xl">
        Curated collections of vibrant, striking, and emotional images for each essay, organized by theme.
        Click any image to copy its URL to clipboard.
      </p>
    </div>

    <div class="space-y-16">
      {essaySections.map((section, sectionIndex) => (
        <section id={section.slug}>
          <div class="mb-6 border-b border-base-300 pb-4">
            <h2 class="font-heading text-3xl font-normal tracking-tight leading-[1.1] mb-2">
              {section.title}
            </h2>
            <p class="text-base-content/70">{section.description}</p>
          </div>
          
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
            {section.images.map((image, imageIndex) => (
              <article
                class="mood-card group bg-base-100 shadow-lg hover:shadow-xl transition-shadow cursor-pointer"
                data-section={sectionIndex}
                data-image={imageIndex}
                data-url={image.url}
              >
                <div class="relative aspect-[4/3] overflow-hidden bg-base-200">
                  <img
                    src={image.url}
                    alt={image.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                    <span class="text-white text-sm">Click to copy URL</span>
                  </div>
                </div>
                <div class="p-4">
                  <h3 class="font-heading text-lg group-hover:underline">{image.title}</h3>
                  <p class="text-sm text-base-content/70 mt-1">{image.source}</p>
                  <div class="mt-3 flex gap-1">
                    {image.colors.map((color) => (
                      <div
                        class="w-6 h-6 rounded-sm border border-base-300"
                        style={`background-color: ${color}`}
                        title={color}
                      />
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </Container>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    initializeMoodboard();
  });

  document.addEventListener('DOMContentLoaded', () => {
    if (!document.querySelector('view-transitions')) {
      initializeMoodboard();
    }
  });

  function initializeMoodboard() {
    const cards = document.querySelectorAll('.mood-card');

    cards.forEach(card => {
      card.addEventListener('click', () => {
        const url = card instanceof HTMLElement ? card.dataset.url : undefined;
        
        if (url) {
          navigator.clipboard.writeText(url);
          
          card.classList.add('ring-2', 'ring-primary');
          setTimeout(() => {
            card.classList.remove('ring-2', 'ring-primary');
          }, 1000);
        }
      });
    });
  }
</script>
