---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { getReadingTime } from '../../lib/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return !data.draft || import.meta.env.DEV;
  });

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(mdx?|md)$/, '') },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const readingTime = getReadingTime(post.body ?? '');

const formattedDate = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="py-12 sm:py-16">
    <Container narrow>
      <header class="mb-10">
        {post.data.draft && (
          <span class="mb-3 inline-block rounded bg-yellow-100 px-2 py-1 text-xs font-medium text-yellow-800">
            Draft
          </span>
        )}
        <h1 class="text-3xl font-bold leading-tight sm:text-4xl">
          {post.data.title}
        </h1>
        <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-gray-600">
          <span>{post.data.author}</span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={post.data.publishDate.toISOString()}>
            {formattedDate}
          </time>
          <span aria-hidden="true">&middot;</span>
          <span>{readingTime}</span>
        </div>
        {post.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <div class="prose prose-lg max-w-none">
        <Content />
      </div>

      <!-- Subscribe CTA -->
      <aside class="mt-12 rounded-lg border border-gray-200 bg-gray-50 p-6 text-center">
        <p class="font-medium">Enjoyed this essay?</p>
        <p class="mt-1 text-sm text-gray-600">
          Subscribe to get new essays delivered to your inbox.
        </p>
        <a
          href="/subscribe"
          class="mt-4 inline-flex items-center rounded-full bg-[#1A1A1A] px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800"
        >
          Subscribe
        </a>
      </aside>
    </Container>
  </article>

  <footer class="border-t border-gray-200 py-8">
    <Container narrow>
      <a
        href="/blog"
        class="text-[#A8BCA1] hover:underline"
      >
        &larr; All essays
      </a>
    </Container>
  </footer>
</BaseLayout>
