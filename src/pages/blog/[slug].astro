---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getReadingTime } from '../../lib/reading-time';
import { getRelatedPosts, getSeriesPosts } from '../../lib/related-posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return !data.draft || import.meta.env.DEV;
  });

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(mdx?|md)$/, '') },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const slug = post.id.replace(/\.(mdx?|md)$/, '');
const { Content, headings } = await post.render();

const readingTime = getReadingTime(post.body ?? '');
const relatedPosts = await getRelatedPosts(post, 3);

// Get series posts if this post is part of a series
const seriesPosts = post.data.series
  ? await getSeriesPosts(post.data.series)
  : [];
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  author={post.data.author}
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  coverImage={post.data.coverImage}
  draft={post.data.draft}
  readingTime={readingTime}
  headings={headings}
  relatedPosts={relatedPosts}
  series={post.data.series}
  seriesPosts={seriesPosts}
  currentPostId={post.id}
  slug={slug}
>
  <Content />
</BlogPostLayout>
