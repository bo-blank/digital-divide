---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import HeroImage from '../../components/HeroImage.astro';
import Pagination from '../../components/Pagination.astro';
import { getPublishedPosts } from '../../lib/content-utils';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

---

<BaseLayout
  title={page.currentPage === 1 ? 'Essays' : `Essays - Page ${page.currentPage}`}
  description="Long-form essays exploring technology, culture, and the human experience."
>
  <HeroImage
    src="https://images.unsplash.com/photo-1558591710-4b4a1ae0f04d?w=1600&h=600&fit=crop"
    alt="Bold colorful vector-style illustration with geometric shapes and gradients"
  >
    <h1 class="text-3xl sm:text-4xl font-heading font-normal tracking-tight text-base-content">
      Essays
    </h1>
    <p class="mt-3 text-base text-base-content/80">
      Long-form explorations of technology, culture, and the spaces between.
    </p>
  </HeroImage>

  <section class="py-12 sm:py-16">
    <Container>
      {page.data.length > 0 ? (
        <>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {page.data.map((post) => (
              <article class="card bg-base-100 rounded-none shadow-[0_2px_8px_rgba(91,127,199,0.3)] hover:shadow-[0_4px_16px_rgba(91,127,199,0.4)] transition-shadow">
                {post.data.coverImage ? (
                  <figure>
                    <a href={`/blog/${post.id}`}>
                      <img
                        src={post.data.coverImage.src}
                        alt={post.data.coverImage.alt}
                        class="h-48 w-full object-cover"
                        loading="lazy"
                      />
                    </a>
                  </figure>
                ) : (
                  <div class="h-48 w-full bg-primary/10 flex items-center justify-center">
                    <a href={`/blog/${post.id}`}>
                      <span class="text-primary/30 text-4xl font-heading">DD</span>
                    </a>
                  </div>
                )}
                <div class="card-body">
                  {post.data.draft && (
                    <span class="badge badge-secondary badge-sm w-fit mb-2">
                      Draft
                    </span>
                  )}
                  <a href={`/blog/${post.id}`} class="hover:text-primary transition-colors">
                    <h2 class="card-title text-lg">
                      {post.data.title}
                    </h2>
                  </a>
                  <p class="text-base-content/70 line-clamp-3 text-sm">
                    {post.data.description}
                  </p>
                  <div class="mt-auto pt-4 flex flex-wrap items-center gap-2 text-xs text-base-content/70">
                    <span>{post.data.author}</span>
                    <span aria-hidden="true">&middot;</span>
                    <time datetime={post.data.publishDate.toISOString()}>
                      {formatDate(post.data.publishDate)}
                    </time>
                  </div>
                  {post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1 mt-2">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <a href={`/tags/${tag}`}>
                          {tag}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>

          <div class="mt-12">
            <Pagination
              currentPage={page.currentPage}
              totalPages={page.lastPage}
              baseUrl="/blog"
            />
          </div>
        </>
      ) : (
        <p class="text-base-content/70 text-center py-12">
          No essays published yet. Check back soon.
        </p>
      )}
    </Container>
  </section>
</BaseLayout>
