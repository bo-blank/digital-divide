---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import HeroImage from '../../components/HeroImage.astro';
import { getPublishedPosts } from '../../lib/content-utils';

const posts = await getPublishedPosts();

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout
  title="Essays"
  description="Long-form essays exploring technology, culture, and the human experience."
>
  <HeroImage
    src="https://images.unsplash.com/photo-1457369804613-52c61a468e7d?w=1600&h=600&fit=crop"
    alt="Open book with reading glasses, representing thoughtful essays"
  >
    <h1 class="text-3xl sm:text-4xl font-heading font-normal tracking-tight text-base-content">
      Essays
    </h1>
    <p class="mt-3 text-base text-base-content/80">
      Long-form explorations of technology, culture, and the spaces between.
    </p>
  </HeroImage>

  <section class="py-12 sm:py-16">
    <Container>

      {posts.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <div class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
              {post.data.coverImage ? (
                <figure>
                  <a href={`/blog/${post.id.replace(/\.(mdx?|md)$/, '')}`}>
                    <img
                      src={post.data.coverImage.src}
                      alt={post.data.coverImage.alt}
                      class="h-48 w-full object-cover"
                      loading="lazy"
                    />
                  </a>
                </figure>
              ) : (
                <div class="h-48 w-full bg-primary/10 flex items-center justify-center">
                  <a href={`/blog/${post.id.replace(/\.(mdx?|md)$/, '')}`}>
                    <span class="text-primary/30 text-4xl font-heading">DD</span>
                  </a>
                </div>
              )}
              <div class="card-body">
                {post.data.draft && (
                  <span class="badge badge-secondary badge-sm w-fit mb-2">
                    Draft
                  </span>
                )}
                <a href={`/blog/${post.id.replace(/\.(mdx?|md)$/, '')}`} class="hover:text-primary transition-colors">
                  <h2 class="card-title text-lg">
                    {post.data.title}
                  </h2>
                </a>
                <p class="text-base-content/70 line-clamp-3 text-sm">
                  {post.data.description}
                </p>
                <div class="mt-auto pt-4 flex flex-wrap items-center gap-2 text-xs text-base-content/70">
                  <span>{post.data.author}</span>
                  <span aria-hidden="true">&middot;</span>
                  <time datetime={post.data.publishDate.toISOString()}>
                    {formatDate(post.data.publishDate)}
                  </time>
                </div>
                {post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1 mt-2">
                    {post.data.tags.map((tag) => (
                      <a href={`/tags/${tag}`}>
                        {tag}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-base-content/70 text-center py-12">
          No essays published yet. Check back soon.
        </p>
      )}
    </Container>
  </section>
</BaseLayout>
