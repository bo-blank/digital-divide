---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => {
    return !data.draft || import.meta.env.DEV;
  });

  return notes.map((note) => ({
    params: { slug: note.id.replace(/\.(mdx?|md)$/, '') },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await note.render();

const formattedDate = note.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const title = note.data.title || `Note from ${formattedDate}`;
---

<BaseLayout title={title}>
  <section class="py-12 sm:py-16">
    <Container narrow>
      <article>
        <header class="mb-8">
          {note.data.draft && (
            <span class="mb-2 inline-block rounded bg-secondary/20 px-2 py-1 text-xs font-medium text-secondary">
              Draft
            </span>
          )}
          {note.data.title && (
            <h1>
              {note.data.title}
            </h1>
          )}
          <time
            datetime={note.data.publishDate.toISOString()}
            class="mt-2 block text-sm text-base-content/70"
          >
            {formattedDate}
          </time>
          {note.data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {note.data.tags.map((tag) => (
                <a
                  href={`/tags/${tag}`}
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <div class="prose prose-lg max-w-none">
          <Content />
        </div>
      </article>

      <footer class="mt-12 border-t border-base-300 pt-8">
        <a
          href="/notes"
          class="text-primary hover:underline"
        >
          &larr; All notes
        </a>
      </footer>
    </Container>
  </section>
</BaseLayout>
