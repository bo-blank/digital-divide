---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import PageBanner from '../../components/PageBanner.astro';
import { getPublishedNotes } from '../../lib/content-utils';

const notes = await getPublishedNotes();

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function getPreview(body: string, maxLength = 150): string {
  const text = body
    .replace(/^---[\s\S]*?---\s*/m, '')  // strip frontmatter if present
    .replace(/!\[.*?\]\(.*?\)/g, '')       // strip images
    .replace(/\[([^\]]+)\]\(.*?\)/g, '$1') // links → text
    .replace(/#{1,6}\s+/g, '')             // strip headings
    .replace(/[*_~`>]/g, '')               // strip emphasis/quotes
    .replace(/^-\s+/gm, '')               // strip list markers
    .replace(/\n+/g, ' ')                 // collapse newlines
    .trim();
  return text.length > maxLength ? text.slice(0, maxLength).trimEnd() + '…' : text;
}
---

<BaseLayout
  title="Notes"
  description="Quick thoughts, observations, and brief commentary on technology and culture."
>
  <PageBanner
    src="https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?w=1600&h=600&fit=crop"
    alt="Vibrant gradient vector illustration with colorful flowing waves"
  >
    <h1 class="text-3xl sm:text-4xl font-heading font-normal tracking-tight text-accent-content">
      Notes
    </h1>
    <p class="mt-3 text-base text-accent-content/90">
      Quick thoughts and observations. Less polished, more frequent.
    </p>
  </PageBanner>

  <section class="py-12 sm:py-16">
    <Container>

      {notes.length > 0 ? (
        <div class="space-y-8">
          {notes.map((note) => (
            <article class="group border-l-2 border-base-300 pl-6 hover:border-primary transition-colors">
              <a href={`/notes/${note.id}`} class="block">
                {note.data.draft && (
                  <span class="mb-2 inline-block rounded bg-secondary/20 px-2 py-1 text-xs font-medium text-secondary">
                    Draft
                  </span>
                )}
                {note.data.title ? (
                  <h2 class="text-xl font-semibold group-hover:text-primary transition-colors">
                    {note.data.title}
                  </h2>
                ) : (
                  <p class="text-base-content group-hover:text-primary transition-colors">
                    View note &rarr;
                  </p>
                )}
                <time
                  datetime={note.data.publishDate.toISOString()}
                  class="mt-2 block text-sm text-base-content/70"
                >
                  {formatDate(note.data.publishDate)}
                </time>
                {note.body && (
                  <p class="mt-2 text-sm text-base-content/70 line-clamp-2">
                    {getPreview(note.body)}
                  </p>
                )}
              </a>
              {note.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {note.data.tags.map((tag) => (
                    <a href={`/tags/${tag}`}>
                      {tag}
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="text-base-content/70 text-center py-12">
          No notes published yet. Check back soon.
        </p>
      )}
    </Container>
  </section>
</BaseLayout>
