---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { getPublishedNotes } from '../../lib/content-utils';

const notes = await getPublishedNotes();

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout
  title="Notes"
  description="Quick thoughts, observations, and brief commentary on technology and culture."
>
  <section class="py-12 sm:py-16">
    <Container>
      <header class="mb-12">
        <h1 class="text-3xl font-bold sm:text-4xl">Notes</h1>
        <p class="mt-4 text-lg text-gray-600">
          Quick thoughts and observations. Less polished, more frequent.
        </p>
      </header>

      {notes.length > 0 ? (
        <div class="space-y-8">
          {notes.map((note) => (
            <article class="group border-l-2 border-gray-200 pl-6 hover:border-[#A8BCA1] transition-colors">
              <a href={`/notes/${note.id.replace(/\.(mdx?|md)$/, '')}`} class="block">
                {note.data.draft && (
                  <span class="mb-2 inline-block rounded bg-yellow-100 px-2 py-1 text-xs font-medium text-yellow-800">
                    Draft
                  </span>
                )}
                {note.data.title ? (
                  <h2 class="text-xl font-semibold group-hover:text-[#A8BCA1] transition-colors">
                    {note.data.title}
                  </h2>
                ) : (
                  <p class="text-gray-700 group-hover:text-[#A8BCA1] transition-colors">
                    View note &rarr;
                  </p>
                )}
                <time
                  datetime={note.data.publishDate.toISOString()}
                  class="mt-2 block text-sm text-gray-500"
                >
                  {formatDate(note.data.publishDate)}
                </time>
                {note.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {note.data.tags.map((tag) => (
                      <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-gray-500 text-center py-12">
          No notes published yet. Check back soon.
        </p>
      )}
    </Container>
  </section>
</BaseLayout>
