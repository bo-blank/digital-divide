---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { mdxComponents } from '../components/mdx/components';

// The prose lives in src/content/pages/privacy.mdx so it can be edited in
// Keystatic (singletons.privacy). This file owns the chrome only.
const page = await getEntry('pages', 'privacy');

if (!page) {
  throw new Error(
    'Missing src/content/pages/privacy.mdx — /privacy renders its prose from the `pages` collection.'
  );
}

const { Content } = await render(page);

// Month and year only, unlike formatDate's day-level output: a policy is
// revised in a given month, and a to-the-day date invites the reader to
// wonder what changed that Tuesday.
const lastUpdated = page.data.updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="py-12 sm:py-16">
    <Container narrow>
      <header class="mb-12">
        <h1>{page.data.title}</h1>
        {lastUpdated && (
          <p class="mt-4 text-base-content/70">Last updated: {lastUpdated}</p>
        )}
      </header>

      <div class="prose prose-lg max-w-none">
        {page.data.lead && (
          <p class="text-xl text-base-content/70 leading-relaxed">
            {page.data.lead}
          </p>
        )}
        <Content components={mdxComponents} />
      </div>
    </Container>
  </section>
</BaseLayout>
