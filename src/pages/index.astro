---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { getPublishedPosts, getPublishedNotes } from '../lib/content-utils';
import { getReadingTime } from '../lib/reading-time';

const posts = await getPublishedPosts();
const notes = await getPublishedNotes();

const recentPosts = posts.slice(0, 5);
const recentNotes = notes.slice(0, 3);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title="Digital Divide">
  <!-- Hero Section -->
  <section class="py-16 sm:py-24">
    <Container>
      <div class="max-w-2xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Digital Divide
        </h1>
        <p class="mt-6 text-lg text-gray-600 leading-relaxed">
          Essays exploring the intersection of technology and humanity.
          We examine how digital tools shape our relationships, communities,
          and sense of self.
        </p>
        <div class="mt-8 flex gap-4">
          <a
            href="/subscribe"
            class="inline-flex items-center rounded-full bg-[#1A1A1A] px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-gray-800"
          >
            Subscribe
          </a>
          <a
            href="/about"
            class="inline-flex items-center rounded-full border border-gray-300 px-6 py-3 text-sm font-medium transition-colors hover:border-gray-400"
          >
            Learn more
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Recent Essays -->
  <section class="py-12 border-t border-gray-200">
    <Container>
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold">Recent Essays</h2>
        <a href="/blog" class="text-sm text-[#A8BCA1] hover:underline">
          View all &rarr;
        </a>
      </div>

      {recentPosts.length > 0 ? (
        <div class="space-y-8">
          {recentPosts.map((post) => (
            <article class="group">
              <a href={`/blog/${post.id.replace(/\.(mdx?|md)$/, '')}`} class="block">
                <h3 class="text-xl font-semibold group-hover:text-[#A8BCA1] transition-colors">
                  {post.data.title}
                </h3>
                <p class="mt-2 text-gray-600 line-clamp-2">
                  {post.data.description}
                </p>
                <div class="mt-3 flex items-center gap-2 text-sm text-gray-500">
                  <time datetime={post.data.publishDate.toISOString()}>
                    {formatDate(post.data.publishDate)}
                  </time>
                  <span aria-hidden="true">&middot;</span>
                  <span>{getReadingTime(post.body ?? '')}</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-gray-500">No essays published yet.</p>
      )}
    </Container>
  </section>

  <!-- Recent Notes -->
  {recentNotes.length > 0 && (
    <section class="py-12 border-t border-gray-200">
      <Container>
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-2xl font-bold">Notes</h2>
          <a href="/notes" class="text-sm text-[#A8BCA1] hover:underline">
            View all &rarr;
          </a>
        </div>

        <div class="space-y-6">
          {recentNotes.map((note) => (
            <article class="group border-l-2 border-gray-200 pl-4 hover:border-[#A8BCA1] transition-colors">
              <a href={`/notes/${note.id.replace(/\.(mdx?|md)$/, '')}`} class="block">
                {note.data.title && (
                  <h3 class="font-medium group-hover:text-[#A8BCA1] transition-colors">
                    {note.data.title}
                  </h3>
                )}
                <time
                  datetime={note.data.publishDate.toISOString()}
                  class="text-sm text-gray-500"
                >
                  {formatDate(note.data.publishDate)}
                </time>
              </a>
            </article>
          ))}
        </div>
      </Container>
    </section>
  )}

  <!-- Newsletter CTA -->
  <section class="py-16 border-t border-gray-200 bg-gray-50">
    <Container>
      <div class="text-center max-w-xl mx-auto">
        <h2 class="text-2xl font-bold">Stay in the loop</h2>
        <p class="mt-4 text-gray-600">
          Get new essays delivered directly to your inbox. No spam, unsubscribe anytime.
        </p>
        <a
          href="/subscribe"
          class="mt-6 inline-flex items-center rounded-full bg-[#1A1A1A] px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-gray-800"
        >
          Subscribe to newsletter
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
