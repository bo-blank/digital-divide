---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
}

const {
  title,
  description = 'Essays exploring the intersection of technology and humanity.',
  ogImage,
  ogImageAlt,
  ogType = 'website',
  publishDate,
  updatedDate,
  author,
} = Astro.props;

const siteTitle = 'Digital Divide';
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;

// Crawlers reject relative og:image values, so everything is absolutised here.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Every page gets a card. Callers that have a cover image pass one already
// cropped to 1200x630; the rest fall back to the branded default, which is why
// summary_large_image is now unconditional — it can no longer come up empty.
// Regenerate the fallback with `npm run og` (scripts/generate-og-image.mjs).
const OG_FALLBACK = { src: '/og-default.png', width: 1200, height: 630 };
const ogImageUrl = new URL(ogImage ?? OG_FALLBACK.src, Astro.site).href;
const resolvedOgAlt = ogImageAlt ?? `${siteTitle} — ${description}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />

    {/* Must stay here, first and render-blocking, before any stylesheet:
        applying the theme any later lets the page paint light first, which
        is a visible white flash for dark-mode readers on every cold load. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored === 'dark' ||
            (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        } catch (e) {
          /* localStorage can throw in private mode; fall through to light. */
        }
      })();
    </script>

    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    {/* Self-hosted: Fraunces (headings), Lora (body), Inter (UI), Caveat (notes).
        Only the regular upright face of the two fonts that render above the
        fold is preloaded — preloading all 14 faces would contend with the
        stylesheet for bandwidth and cost more than the swap it avoids. */}
    <Font cssVariable="--font-fraunces" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-lora" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-caveat" />

    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_FALLBACK.width)} />
    <meta property="og:image:height" content={String(OG_FALLBACK.height)} />
    <meta property="og:image:alt" content={resolvedOgAlt} />
    {ogType === 'article' && publishDate && (
      <meta property="article:published_time" content={publishDate.toISOString()} />
    )}
    {ogType === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    {ogType === 'article' && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={resolvedOgAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1" style="padding-top: var(--header-height, 104px);" transition:animate="fade">
      <slot />
    </main>
    <Footer />

    <!-- Preserve theme during View Transitions -->
    <script is:inline>
      // Apply theme immediately before swap to prevent flash
      document.addEventListener('astro:before-swap', (event) => {
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = theme === 'dark' || (!theme && prefersDark);

        if (isDark) {
          event.newDocument.documentElement.classList.add('dark');
          event.newDocument.documentElement.setAttribute('data-theme', 'dark');
        } else {
          event.newDocument.documentElement.classList.remove('dark');
          event.newDocument.documentElement.setAttribute('data-theme', 'light');
        }
      });
    </script>
  </body>
</html>
