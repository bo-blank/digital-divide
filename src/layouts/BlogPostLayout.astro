---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SeriesNav from '../components/SeriesNav.astro';
import CopyButton from '../components/CopyButton.astro';
import type { TocItem } from '../components/TableOfContents.astro';
import { formatDate } from '../lib/format-date';

interface Props {
  title: string;
  description: string;
  author: string;
  publishDate: Date;
  updatedDate?: Date;
  tags: string[];
  coverImage?: {
    src: ImageMetadata;
    alt: string;
    caption?: string;
    position?: string;
  };
  draft?: boolean;
  readingTime: string;
  headings?: TocItem[];
  relatedPosts?: CollectionEntry<'blog'>[];
  series?: string;
  seriesPosts?: CollectionEntry<'blog'>[];
  currentPostId?: string;
  slug?: string;
}

const {
  title,
  description,
  author,
  publishDate,
  updatedDate,
  tags,
  coverImage,
  draft,
  readingTime,
  headings = [],
  relatedPosts = [],
  series,
  seriesPosts = [],
  currentPostId,
  slug,
} = Astro.props;

const pageUrl = Astro.url.href;

// Social slots are a fixed 1200x630, so this is one of the few places an
// explicit height is right — `fit: 'cover'` crops to it instead of squashing
// the source, which matters because the covers are not all the same aspect.
// JPEG rather than the site's usual WebP: several crawlers still ignore WebP.
const ogImageSrc = coverImage
  ? (await getImage({
      src: coverImage.src,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpeg',
    })).src
  : undefined;

const formattedDate = formatDate(publishDate);
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={ogImageSrc}
  ogImageAlt={coverImage?.alt}
  publishDate={publishDate}
  updatedDate={updatedDate}
  author={author}
>
  <article class="py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 lg:px-16">
      <header class="mb-12 max-w-3xl mx-auto">
        {draft && (
          <span class="mb-3 inline-block rounded bg-secondary/20 px-2 py-1 text-xs font-medium text-secondary">
            Draft
          </span>
        )}
        <h1 class="leading-tight" transition:name={slug ? `post-title-${slug}` : undefined}>
          {title}
        </h1>
        <p class="mt-4 text-xl text-base-content/80 font-body leading-relaxed">
          {description}
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-base-content/70">
          <span>{author}</span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={publishDate.toISOString()}>
            {formattedDate}
          </time>
          {updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <time datetime={updatedDate.toISOString()}>
                Updated: {formatDate(updatedDate)}
              </time>
            </>
          )}
          {readingTime && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>{readingTime}</span>
            </>
          )}
        </div>
        {tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2 max-w-3xl">
            {tags.map((tag) => (
              <a
                href={`/tags/${tag}`}
              >
                {tag}
              </a>
            ))}
          </div>
        )}
      </header>

      {coverImage && (
        <figure class="mb-12 -mx-6 sm:-mx-10 lg:-mx-16">
          <Image
            src={coverImage.src}
            alt={coverImage.alt}
            width={1400}
            class="w-full object-cover aspect-video"
            style={coverImage.position ? `object-position: ${coverImage.position};` : undefined}
            loading="eager"
            transition:name={slug ? `post-image-${slug}` : undefined}
          />
          {coverImage.caption && (
            <figcaption class="mt-3 text-center text-sm text-base-content/70 px-6 sm:px-10 lg:px-16">
              {coverImage.caption}
            </figcaption>
          )}
        </figure>
      )}

      {/* Table of Contents for long articles */}
      {headings.length > 3 && (
        <div class="mb-12 max-w-3xl mx-auto">
          <TableOfContents headings={headings} />
        </div>
      )}

      {/* Series navigation */}
      {series && seriesPosts.length > 1 && currentPostId && (
        <div class="mb-12 max-w-3xl mx-auto">
          <SeriesNav series={series} posts={seriesPosts} currentPostId={currentPostId} />
        </div>
      )}

      <div class="prose prose-lg max-w-3xl mx-auto">
        <slot />
      </div>

      {/* Share buttons */}
      <div class="mt-14 pt-8 border-t border-base-300 max-w-3xl mx-auto">
        <ShareButtons url={pageUrl} title={title} description={description} />
      </div>

      {/* Subscribe CTA */}
      <aside class="mt-12 max-w-3xl mx-auto rounded-lg border border-base-300 bg-base-200 p-8 text-center">
        <p class="font-medium">Enjoyed this essay?</p>
        <p class="mt-1 text-sm text-base-content/70">
          Subscribe to get new essays delivered to your inbox.
        </p>
        <a href="/subscribe" class="btn btn-primary btn-sm mt-4">
          Subscribe
        </a>
      </aside>

      {/* Related posts */}
      {relatedPosts.length > 0 && (
        <div class="mt-14 max-w-3xl mx-auto">
          <RelatedPosts posts={relatedPosts} />
        </div>
      )}
    </div>
  </article>

  <CopyButton />

  <!-- <nav>, not <footer>: a <footer> with no sectioning ancestor maps to
       role="contentinfo" and would collide with the site footer in BaseLayout. -->
  <nav aria-label="Post navigation" class="border-t border-base-300 py-8">
    <Container>
      <a
        href="/blog"
        class="text-primary hover:underline"
      >
        &larr; All essays
      </a>
    </Container>
  </nav>
</BaseLayout>
