---
interface Props {
  src?: string;
  alt?: string;
  variant?: 'banner' | 'split';
  class?: string;
  objectPosition?: string;
  height?: string;
}

const {
  src,
  alt = '',
  variant = 'banner',
  class: className = '',
  objectPosition = 'center',
  height = 'min-h-[50vh]',
} = Astro.props;
---

{variant === 'banner' ? (
  <div class:list={['w-full bg-accent text-white py-3 px-6 mt-4 flex items-center justify-center gap-4', className]}>
    <slot />
  </div>
) : (
  <div class:list={['relative bg-accent lg:min-h-full', height, className]}>
    {src && (
      <img
        src={src}
        alt={alt}
        class="absolute inset-0 w-full h-full object-cover"
        style={`object-position: ${objectPosition};`}
      />
    )}
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="relative z-10 flex items-center justify-center h-full text-white">
      <slot />
    </div>
  </div>
)}
