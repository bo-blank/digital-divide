---
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  variant?: 'banner' | 'split';
  class?: string;
  objectPosition?: string;
  height?: string;
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt = '',
  variant = 'banner',
  class: className = '',
  objectPosition = 'center',
  height = 'min-h-[40vh] sm:min-h-[50vh]',
  loading = 'eager',
} = Astro.props;
---

{variant === 'banner' ? (
  <div class:list={['w-full bg-accent text-accent-content py-3 px-6 mt-4 flex items-center justify-center gap-4', className]}>
    <slot />
  </div>
) : (
  <div class:list={['relative bg-accent lg:min-h-full', height, className]}>
    {src && (
      <Image
        src={src}
        alt={alt}
        width={1200}
        class="absolute inset-0 w-full h-full object-cover"
        style={`object-position: ${objectPosition};`}
        loading={loading}
      />
    )}
    {/* black/60, not /40: white text needs the scrim's composited luminance
        below ~0.18 to clear 4.5:1 against a *worst-case* (pure white) photo.
        /40 measured 2.85:1 there; /60 clears ~5.7:1 regardless of the image,
        so contrast no longer depends on which photo gets used. */}
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative z-10 flex items-center justify-center h-full text-white">
      <slot />
    </div>
  </div>
)}
