---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getPublishedPosts, getPublishedNotes } from '../lib/content-utils';
import { getTagLabeller } from '../lib/tag-labels';
import type { Lang } from '../i18n/config';
import { localePath, type Alternate } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Passed straight through to the language switcher — see BaseLayout. */
  alternates: Alternate[];
}

const { lang, alternates } = Astro.props;
const { t } = useTranslations(lang);
const tagLabel = await getTagLabeller(lang);

const navLinks = [
  { href: localePath(lang, '/essays'), label: t('nav.essays') },
  { href: localePath(lang, '/notes'), label: t('nav.notes') },
  { href: localePath(lang, '/tags'), label: t('nav.tags') },
  { href: localePath(lang, '/about'), label: t('nav.about') },
];

// Calculate trending tags based on recent content only — scoped to this
// locale, or the English nav would surface tags whose only posts are German
// (and whose German tag page the English reader cannot reach from here).
const posts = await getPublishedPosts(lang);
const notes = await getPublishedNotes(lang);

// Only consider the 10 most recent posts and notes for trending
const recentPosts = posts.slice(0, 10);
const recentNotes = notes.slice(0, 10);

const tagCounts = new Map<string, number>();
recentPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
recentNotes.forEach((note) => {
  note.data.tags?.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

// Get top 5 most used tags from recent content
const trendingTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);


const trendingTopics = trendingTags.map(([tag]) => ({
  href: localePath(lang, `/tags/${tag}`),
  label: tagLabel(tag),
}));

const currentPath = Astro.url.pathname;

// Astro emits trailing slashes, so /essays/ and /essays/the-tell/ both count as
// /essays, while a sibling like /essays-archive would not. syncActiveNav() in
// the script below repeats this exact predicate — the two must agree or the
// highlight flickers on load. The hrefs are already locale-prefixed, so this
// works unchanged under /de/ without special-casing the locale.
const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);

const homeHref = localePath(lang, '/');
const subscribeHref = localePath(lang, '/subscribe');
---

{/* The persist key is locale-scoped. Without it, navigating from /essays to
    /de/essays via the language switcher would reuse the English header's DOM —
    Astro persists by key, and a bare `transition:persist` keys on the element's
    position, which is identical in both trees. The consequence is subtle and
    ugly: German page, English nav, and no re-render to fix it. */}
<header
  class="fixed left-0 right-0 top-0 z-40 transition-transform duration-300 ease-in-out"
  style="background-color: var(--color-bg-subtle);"
  data-header
  transition:persist={`header-${lang}`}
>
  <nav class="mx-auto max-w-6xl px-4 py-4" aria-label={t('nav.label')}>
    <div class="relative flex items-center justify-center">
      <!-- Left side: Mobile menu -->
      <div class="flex items-center sm:hidden">
        <button
          type="button"
          class="p-2 -ml-2 text-base-content/70 transition-colors hover:text-base-content"
          aria-label={t('nav.openMenu')}
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
          data-label-open={t('nav.openMenu')}
          data-label-close={t('nav.closeMenu')}
        >
          <svg class="h-6 w-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Desktop Left: Nav links -->
      <ul class="hidden items-center gap-6 sm:flex absolute left-0">
        {navLinks.slice(0, 2).map(({ href, label }) => (
          <li>
            <a
              href={href}
              data-nav-link
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'text-sm font-medium transition-colors hover:text-primary',
                isActive(href) ? 'text-primary' : 'text-base-content/70',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Center: Logo -->
      <a
        href={homeHref}
        class="font-heading text-2xl font-semibold tracking-tight transition-opacity hover:opacity-70 sm:text-3xl"
        style="font-family: var(--font-heading);"
      >
        {t('site.title')}
      </a>

      <!-- Desktop Right: Nav links + Subscribe -->
      <div class="flex items-center gap-4 absolute right-0">
        <ul class="hidden items-center gap-6 sm:flex">
          {navLinks.slice(2).map(({ href, label }) => (
            <li>
              <a
                href={href}
                data-nav-link
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'text-sm font-medium transition-colors hover:text-primary',
                  isActive(href) ? 'text-primary' : 'text-base-content/70',
                ]}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Subscribe Button -->
        <a href={subscribeHref} class="btn btn-primary btn-sm min-h-[44px]">
          {t('nav.subscribe')}
        </a>

        <!-- Language Switcher -->
        <LanguageSwitcher lang={lang} alternates={alternates} />

        <!-- Theme Toggle -->
        <ThemeToggle lang={lang} />
      </div>
    </div>

    <!-- Mobile Navigation -->
    {/* `inert` as well as max-h-0: the collapsed menu is only visually
        clipped, so without it these five links stay in the tab order and in
        the accessibility tree on mobile. */}
    <ul
      id="mobile-menu"
      class="mt-4 border-t border-base-300 pt-4 sm:hidden overflow-hidden transition-[max-height,opacity] duration-300 ease-out max-h-0 opacity-0"
      inert
      data-mobile-menu
    >
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            data-nav-link
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'block py-3 text-base font-medium transition-colors hover:text-primary',
              isActive(href) ? 'text-primary' : 'text-base-content/70',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={subscribeHref}
          class="block py-3 text-base font-medium text-primary transition-colors hover:text-primary/80"
        >
          {t('nav.subscribe')}
        </a>
      </li>
    </ul>
  </nav>

  <!-- Trending Topics Bar -->
  <div class="border-t border-base-300 bg-base-200">
    <nav class="mx-auto max-w-6xl px-4 py-2" aria-label={t('nav.trendingLabel')}>
      <div class="flex items-center justify-center gap-4 overflow-x-auto scrollbar-none">
        <span class="flex items-center gap-2 text-sm font-medium text-secondary shrink-0">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-secondary"></span>
          </span>
          {t('nav.trending')}
        </span>
        <ul class="flex items-center gap-4 sm:gap-6">
          {trendingTopics.map(({ href, label }) => (
            <li class="shrink-0">
              <a
                href={href}
                class="tag-link text-sm text-base-content/70 transition-colors hover:text-primary"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const menuToggle = document.querySelector('[data-menu-toggle]');
    const mobileMenu = document.querySelector('[data-mobile-menu]');
    if (!(menuToggle instanceof HTMLElement)) return;

    // The header is transition:persist, so after a client-side navigation this
    // runs again against the same button. Without the guard it collects a
    // second listener and every tap toggles twice, i.e. does nothing.
    if (menuToggle.dataset.menuBound) return;
    menuToggle.dataset.menuBound = 'true';

    menuToggle.addEventListener('click', () => {
      const willExpand = menuToggle.getAttribute('aria-expanded') !== 'true';
      menuToggle.setAttribute('aria-expanded', String(willExpand));
      // Otherwise it announces "Open menu, expanded" while it is the close
      // action. Both labels are handed over as data attributes because this is
      // a <script>, which no template expression reaches — a translated string
      // written inline here would be frozen in English.
      const label = willExpand
        ? menuToggle.dataset.labelClose
        : menuToggle.dataset.labelOpen;
      if (label) menuToggle.setAttribute('aria-label', label);

      if (mobileMenu instanceof HTMLElement) {
        mobileMenu.inert = !willExpand;
        mobileMenu.style.maxHeight = willExpand ? mobileMenu.scrollHeight + 'px' : '0';
        mobileMenu.style.opacity = willExpand ? '1' : '0';
      }
    });
  }

  function setupScrollHeader() {
    const header = document.querySelector('[data-header]');
    if (!header) return;

    let lastScrollY = window.scrollY;
    let ticking = false;

    const updateHeader = () => {
      const currentScrollY = window.scrollY;

      if (currentScrollY <= 0) {
        header.classList.remove('-translate-y-full');
      } else if (currentScrollY > lastScrollY && currentScrollY > 60) {
        header.classList.add('-translate-y-full');
      } else if (currentScrollY < lastScrollY) {
        header.classList.remove('-translate-y-full');
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(updateHeader);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // The header is transition:persist, so its DOM survives a client-side
  // navigation and the active link stays frozen on whichever page was loaded
  // first — the highlight only looked right after a hard refresh. Astro cannot
  // re-render a persisted island, so the state is reapplied here. Must match
  // the isActive() predicate in the frontmatter. The hrefs it compares are
  // already locale-prefixed, so no locale handling is needed here either.
  function syncActiveNav() {
    const path = window.location.pathname;
    document.querySelectorAll('[data-nav-link]').forEach((link) => {
      const href = link.getAttribute('href');
      if (!href) return;
      const active = path === href || path.startsWith(`${href}/`);
      link.classList.toggle('text-primary', active);
      link.classList.toggle('text-base-content/70', !active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  function syncHeaderHeight() {
    const header = document.querySelector('[data-header]');
    if (header) {
      const height = header.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--header-height', `${height}px`);
    }
  }

  setupMobileMenu();
  setupScrollHeader();
  syncHeaderHeight();
  syncActiveNav();
  window.addEventListener('resize', syncHeaderHeight, { passive: true });
  document.addEventListener('astro:after-swap', () => {
    setupMobileMenu();
    setupScrollHeader();
    syncHeaderHeight();
    syncActiveNav();
  });
</script>
