---
import ThemeToggle from './ThemeToggle.astro';
import { getPublishedPosts, getPublishedNotes } from '../lib/content-utils';

const navLinks = [
  { href: '/blog', label: 'Essays' },
  { href: '/notes', label: 'Notes' },
  { href: '/tags', label: 'Tags' },
  { href: '/about', label: 'About' },
];

// Calculate trending tags based on recent content only
const posts = await getPublishedPosts();
const notes = await getPublishedNotes();

// Only consider the 10 most recent posts and notes for trending
const recentPosts = posts.slice(0, 10);
const recentNotes = notes.slice(0, 10);

const tagCounts = new Map<string, number>();
recentPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
recentNotes.forEach((note) => {
  note.data.tags?.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

// Get top 5 most used tags from recent content
const trendingTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);

function formatTagDisplay(tag: string): string {
  // Convert underscores and hyphens to spaces and capitalize each word
  return tag
    .split(/[_-]/)
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

const trendingTopics = trendingTags.map(([tag]) => ({
  href: `/tags/${tag}`,
  label: formatTagDisplay(tag),
}));

const currentPath = Astro.url.pathname;
---

<header class="fixed left-0 right-0 top-0 z-40 transition-transform duration-300 ease-in-out" style="background-color: var(--color-bg-subtle);" data-header transition:persist>
  <nav class="mx-auto max-w-6xl px-4 py-4">
    <div class="relative flex items-center justify-center">
      <!-- Left side: Mobile menu -->
      <div class="flex items-center sm:hidden">
        <button
          type="button"
          class="p-2 -ml-2 text-base-content/70 transition-colors hover:text-base-content"
          aria-label="Open menu"
          aria-expanded="false"
          data-menu-toggle
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Desktop Left: Nav links -->
      <ul class="hidden items-center gap-6 sm:flex absolute left-0">
        {navLinks.slice(0, 2).map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'text-sm font-medium transition-colors hover:text-primary',
                currentPath.startsWith(href)
                  ? 'text-primary'
                  : 'text-base-content/70',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Center: Logo -->
      <a
        href="/"
        class="font-heading text-2xl font-semibold tracking-tight transition-opacity hover:opacity-70 sm:text-3xl"
        style="font-family: var(--font-heading);"
      >
        Digital Divide
      </a>

      <!-- Desktop Right: Nav links + Subscribe -->
      <div class="flex items-center gap-4 absolute right-0">
        <ul class="hidden items-center gap-6 sm:flex">
          {navLinks.slice(2).map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  'text-sm font-medium transition-colors hover:text-primary',
                  currentPath.startsWith(href)
                    ? 'text-primary'
                    : 'text-base-content/70',
                ]}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Subscribe Button -->
        <a href="/subscribe" class="btn btn-primary btn-sm">
          Subscribe
        </a>

        <!-- Theme Toggle -->
        <ThemeToggle />
      </div>
    </div>

    <!-- Mobile Navigation -->
    <ul class="hidden mt-4 border-t border-base-300 pt-4 sm:hidden" data-mobile-menu>
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'block py-3 text-base font-medium transition-colors hover:text-primary',
              currentPath.startsWith(href)
                ? 'text-primary'
                : 'text-base-content/70',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/subscribe"
          class="block py-3 text-base font-medium text-primary transition-colors hover:text-primary/80"
        >
          Subscribe
        </a>
      </li>
    </ul>
  </nav>

  <!-- Trending Topics Bar -->
  <div class="border-t border-base-300 bg-base-200">
    <div class="mx-auto max-w-6xl px-4 py-2">
      <div class="flex items-center justify-center gap-4">
        <span class="flex items-center gap-2 text-sm font-medium text-secondary">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-secondary"></span>
          </span>
          Trending
        </span>
        <ul class="flex items-center gap-4 sm:gap-6">
          {trendingTopics.map(({ href, label }) => (
            <li class="shrink-0">
              <a
                href={href}
                class="text-sm text-base-content/70 transition-colors hover:text-primary"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const menuToggle = document.querySelector('[data-menu-toggle]');
    const mobileMenu = document.querySelector('[data-mobile-menu]');

    menuToggle?.addEventListener('click', () => {
      const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu?.classList.toggle('hidden');
    });
  }

  function setupScrollHeader() {
    const header = document.querySelector('[data-header]');
    if (!header) return;

    let lastScrollY = window.scrollY;
    let ticking = false;

    const updateHeader = () => {
      const currentScrollY = window.scrollY;

      if (currentScrollY <= 0) {
        header.classList.remove('-translate-y-full');
      } else if (currentScrollY > lastScrollY && currentScrollY > 60) {
        header.classList.add('-translate-y-full');
      } else if (currentScrollY < lastScrollY) {
        header.classList.remove('-translate-y-full');
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(updateHeader);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
  }

  setupMobileMenu();
  setupScrollHeader();
  document.addEventListener('astro:after-swap', () => {
    setupMobileMenu();
    setupScrollHeader();
  });
</script>
