---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../Container.astro';
import PageBanner from '../PageBanner.astro';
import Pagination from '../Pagination.astro';
import PostCard from '../PostCard.astro';
import { getPublishedPosts } from '../../lib/content-utils';
import { locales, type Lang } from '../../i18n/config';
import { localePath, type Alternate } from '../../i18n/routing';
import { useTranslations } from '../../i18n/ui';

export const PAGE_SIZE = 12;

/** The paginated essays archive, shared by /essays and /de/essays. */
interface Props {
  lang: Lang;
  page: Page<CollectionEntry<'blog'>>;
}

const { lang, page } = Astro.props;
const { t } = useTranslations(lang);

const title =
  page.currentPage === 1
    ? t('essays.title')
    : t('essays.titlePaged', { page: page.currentPage });

// Page 1 always exists in both languages; deeper pages only exist where that
// locale has enough essays to fill them. Without this, /essays/3 would claim a
// German counterpart the moment English pulled ahead in translated volume.
const pagePath = (locale: Lang) =>
  localePath(locale, page.currentPage === 1 ? '/essays' : `/essays/${page.currentPage}`);

const alternates: Alternate[] = [{ lang, path: pagePath(lang) }];
for (const other of locales) {
  if (other === lang) continue;
  const lastPage = Math.max(
    1,
    Math.ceil((await getPublishedPosts(other)).length / PAGE_SIZE)
  );
  if (page.currentPage <= lastPage) {
    alternates.push({ lang: other, path: pagePath(other) });
  }
}
---

<BaseLayout title={title} lang={lang} alternates={alternates} description={t('essays.description')}>
  {/* The default `banner` variant is a text-only strip — it never renders
      src/alt, so the image props that used to sit here were dead weight. */}
  <PageBanner>
    <h1 class="text-3xl sm:text-4xl font-heading font-normal tracking-tight text-accent-content">
      {t('essays.title')}
    </h1>
    <p class="mt-3 text-base text-accent-content/90">
      {t('essays.tagline')}
    </p>
  </PageBanner>

  <section class="py-12 sm:py-16">
    <Container>
      {page.data.length > 0 ? (
        <>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {page.data.map((post) => (
              <PostCard post={post} lang={lang} headingLevel={2} />
            ))}
          </div>

          <div class="mt-12">
            <Pagination
              currentPage={page.currentPage}
              totalPages={page.lastPage}
              baseUrl={localePath(lang, '/essays')}
              lang={lang}
            />
          </div>
        </>
      ) : (
        <p class="text-base-content/70 text-center py-12">
          {t('essays.empty')}
        </p>
      )}
    </Container>
  </section>
</BaseLayout>
