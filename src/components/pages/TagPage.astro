---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../Container.astro';
import {
  entrySlug,
  getPublishedNotes,
  getPublishedPosts,
} from '../../lib/content-utils';
import { formatDate } from '../../lib/format-date';
import { getTagLabeller } from '../../lib/tag-labels';
import { locales, type Lang } from '../../i18n/config';
import { localePath, type Alternate } from '../../i18n/routing';
import { useTranslations } from '../../i18n/ui';

/**
 * A single tag's page, shared by /tags/[tag] and /de/tags/[tag].
 *
 * The route files own getStaticPaths — the set of tags differs per locale,
 * since it is built from that locale's own posts and notes.
 */
interface Props {
  lang: Lang;
  tag: string;
  posts: CollectionEntry<'blog'>[];
  notes: CollectionEntry<'notes'>[];
}

const { lang, tag, posts, notes } = Astro.props;
const { t, plural } = useTranslations(lang);
const tagLabel = await getTagLabeller(lang);

// Not BaseLayout's default "same path in every locale": the tag set is built
// per locale from that locale's own content, so /tags/advertising exists while
// /de/tags/advertising does not. Advertising it anyway would point both the
// language switcher and every crawler at a 404.
const alternates: Alternate[] = [
  { lang, path: localePath(lang, `/tags/${tag}/`) },
];
for (const other of locales) {
  if (other === lang) continue;
  const [otherPosts, otherNotes] = await Promise.all([
    getPublishedPosts(other),
    getPublishedNotes(other),
  ]);
  const exists =
    otherPosts.some((post) => post.data.tags.includes(tag)) ||
    otherNotes.some((note) => note.data.tags.includes(tag));
  if (exists) {
    alternates.push({ lang: other, path: localePath(other, `/tags/${tag}/`) });
  }
}
---

<BaseLayout
  title={t('tags.pageTitle', { tag: tagLabel(tag) })}
  lang={lang}
  alternates={alternates}
  description={t('tags.pageDescription', { tag: tagLabel(tag) })}
>
  <section class="py-12 sm:py-16">
    <Container>
      <header class="mb-12">
        <a
          href={localePath(lang, '/tags')}
          class="text-sm text-base-content/70 hover:text-primary transition-colors"
        >
          {t('tags.allTags')}
        </a>
        <h1 class="mt-4">
          {t('tags.taggedPrefix')} <span class="text-accent font-semibold">{tagLabel(tag)}</span>
        </h1>
        <p class="mt-2 text-base-content/70">
          {plural('tags.essayCount', posts.length)}
          {notes.length > 0 && (
            <span> &middot; {plural('tags.noteCount', notes.length)}</span>
          )}
        </p>
      </header>

      {posts.length === 0 && notes.length === 0 ? (
        <p class="text-base-content/70 text-center py-12">
          {t('tags.noContent')}
        </p>
      ) : (
        <div class="grid lg:grid-cols-2 gap-12">
          <!-- Essays Column -->
          <div>
            <h2 class="text-2xl font-heading font-normal mb-6 pb-2 border-b border-base-300">
              {t('tags.essaysHeading')}
            </h2>
            {posts.length > 0 ? (
              <div class="space-y-6">
                {posts.map((post) => (
                  <article class="group">
                    <a href={localePath(lang, `/essays/${entrySlug(post.id)}`)} class="block">
                      <h3 class="text-lg font-semibold group-hover:text-primary transition-colors">
                        {post.data.title}
                      </h3>
                      <p class="mt-2 text-base-content/70 line-clamp-2 text-sm">
                        {post.data.description}
                      </p>
                      <div class="mt-3 flex items-center gap-2 text-xs text-base-content/70">
                        <time datetime={post.data.publishDate.toISOString()}>
                          {formatDate(post.data.publishDate, lang)}
                        </time>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            ) : (
              <p class="text-base-content/60 text-sm italic">{t('tags.noEssays')}</p>
            )}
          </div>

          <!-- Notes Column -->
          <div>
            <h2 class="text-2xl font-heading font-normal mb-6 pb-2 border-b border-base-300">
              {t('tags.notesHeading')}
            </h2>
            {notes.length > 0 ? (
              <div class="space-y-6">
                {notes.map((note) => (
                  <article class="group">
                    <a href={localePath(lang, `/notes/${entrySlug(note.id)}`)} class="block">
                      {note.data.title ? (
                        <h3 class="text-lg font-semibold group-hover:text-primary transition-colors">
                          {note.data.title}
                        </h3>
                      ) : (
                        <p class="text-base-content/70 group-hover:text-primary transition-colors">
                          {t('notes.viewNote')}
                        </p>
                      )}
                      <div class="mt-2 text-xs text-base-content/70">
                        <time datetime={note.data.publishDate.toISOString()}>
                          {formatDate(note.data.publishDate, lang)}
                        </time>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            ) : (
              <p class="text-base-content/60 text-sm italic">{t('tags.noNotes')}</p>
            )}
          </div>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>
