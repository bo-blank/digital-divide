---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../Container.astro';
import { entrySlug, getPublishedPosts, getPublishedNotes } from '../../lib/content-utils';
import { getTagLabeller } from '../../lib/tag-labels';
import { localeMeta, type Lang } from '../../i18n/config';
import { localePath } from '../../i18n/routing';
import { useTranslations } from '../../i18n/ui';

/** The tag index, shared by /tags and /de/tags. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);
const tagLabel = await getTagLabeller(lang);
const collator = new Intl.Collator(localeMeta[lang].dateLocale);

const posts = await getPublishedPosts(lang);
const notes = await getPublishedNotes(lang);

// Notes are included because /tags/[tag] builds its routes from posts *and*
// notes. Counting only posts here left every note-only tag with a live page
// that this index never linked to, and undercounted any shared tag.
const tagged: { tags: string[]; title: string; href: string; date: Date }[] = [
  ...posts.map((p) => ({
    tags: p.data.tags,
    title: p.data.title,
    href: localePath(lang, `/essays/${entrySlug(p.id)}/`),
    date: p.data.publishDate,
  })),
  ...notes.map((n) => ({
    tags: n.data.tags,
    title: n.data.title ?? t('tags.untitledNote'),
    href: localePath(lang, `/notes/${entrySlug(n.id)}/`),
    date: n.data.publishDate,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

// Collect tags with counts and most recent entry
const tagData = new Map<string, { count: number; latestTitle: string; latestHref: string }>();
tagged.forEach((entry) => {
  entry.tags.forEach((tag) => {
    const existing = tagData.get(tag);
    if (!existing) {
      // `tagged` is newest-first, so the first entry seen for a tag is its latest.
      tagData.set(tag, {
        count: 1,
        latestTitle: entry.title,
        latestHref: entry.href,
      });
    } else {
      existing.count += 1;
    }
  });
});

// Build sorted entries and group by first letter
interface TagEntry {
  tag: string;
  /** The rendered label — what this page sorts, groups and displays by. */
  label: string;
  count: number;
  latestTitle: string;
  latestHref: string;
}

// Sorted and grouped by the *label*, not the slug. While the label was just
// the title-cased slug the two were interchangeable; now that it is translated
// they are not, and using the slug files "Werbung" under A, "Kultur" under C
// and "Einführung" under I — an alphabetical index in no alphabet at all.
const entries: TagEntry[] = Array.from(tagData.entries())
  .map(([tag, data]) => ({ tag, label: tagLabel(tag), ...data }))
  .sort((a, b) => collator.compare(a.label, b.label));

/**
 * The heading a label files under. Diacritics fold to their base letter, so
 * "Über" lands in U rather than opening a section of its own — which is both
 * the German convention and the only way a one-entry Ü section is avoided.
 */
function initial(label: string): string {
  return label
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .charAt(0)
    .toUpperCase();
}

const grouped = new Map<string, TagEntry[]>();
entries.forEach((entry) => {
  const letter = initial(entry.label);
  if (!grouped.has(letter)) {
    grouped.set(letter, []);
  }
  grouped.get(letter)!.push(entry);
});

const sortedGroups = Array.from(grouped.entries()).sort((a, b) =>
  collator.compare(a[0], b[0])
);

// Font size scaling based on post count
const allCounts = entries.map((e) => e.count);
const maxCount = Math.max(...allCounts);
const minCount = Math.min(...allCounts);

function getFontSize(count: number): string {
  if (maxCount === minCount) return '1.25rem';
  const ratio = (count - minCount) / (maxCount - minCount);
  const size = 1.125 + ratio * 0.875;
  return `${size.toFixed(3)}rem`;
}

// Cycle through design token colors for letter dividers
const dividerColors = [
  'var(--color-accent)',
  'var(--color-secondary)',
  'var(--color-tertiary)',
];

---

<BaseLayout
  title={t('tags.indexTitle')}
  lang={lang}
  description={t('tags.indexDescription')}
>
  <section class="py-12 sm:py-20">
    <Container>
      <header class="mb-14 sm:mb-20 text-center">
        <p class="text-xs tracking-[0.3em] uppercase text-base-content/50 font-ui mb-3">
          {t('site.title')}
        </p>
        <h1 class="text-4xl sm:text-5xl font-heading font-normal tracking-tight">
          {t('tags.indexHeading')}
        </h1>
        <p class="mt-4 text-base text-base-content/60 font-body italic">
          {t('tags.indexTagline')}
        </p>
        <div class="mt-6 mx-auto w-12 border-t border-base-content/20"></div>
      </header>

      {sortedGroups.length > 0 ? (
        <div class="tag-index max-w-2xl mx-auto">
          {sortedGroups.map(([letter, tags], groupIndex) => (
            <div class="mb-10">
              {/* Letter divider */}
              <div class="letter-divider">
                <span
                  class="letter"
                  style={`color: ${dividerColors[groupIndex % dividerColors.length]};`}
                >
                  {letter}
                </span>
                <span
                  class="letter-line"
                  style={`background-color: ${dividerColors[groupIndex % dividerColors.length]};`}
                ></span>
              </div>

              {/* Tag entries */}
              <div class="tag-list">
                {tags.map((entry) => (
                  <a
                    href={localePath(lang, `/tags/${entry.tag}`)}
                    class="tag-entry"
                  >
                    <span
                      class="tag-name"
                      style={`font-size: ${getFontSize(entry.count)};`}
                    >
                      {entry.label}
                    </span>
                    <span class="tag-leader" aria-hidden="true"></span>
                    <span class="tag-count">{entry.count}</span>
                    <span class="tag-preview" aria-hidden="true">
                      {entry.latestTitle}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-base-content/70 text-center py-12">
          {t('tags.indexEmpty')}
        </p>
      )}
    </Container>
  </section>
</BaseLayout>

<style>
  /* Letter dividers */
  .letter-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .letter {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
  }

  .letter-line {
    flex: 1;
    height: 1px;
    opacity: 0.25;
  }

  /* Tag list */
  .tag-list {
    display: flex;
    flex-direction: column;
    padding-left: 0.25rem;
  }

  /* Individual tag entry row — overrides global pill styles */
  .tag-entry {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 0;
    position: relative;
    overflow: hidden;
    border-radius: 0;
    background: none;
    color: inherit;
    font-size: inherit;
  }

  .tag-entry:hover {
    background: none;
    color: inherit;
  }

  /* Tag name in Fraunces, size set via inline style */
  /* Was inherited from a global pill rule; set here now that it is gone. The
     count deliberately does not get it — muted plus 70% put it under AA. */
  .tag-name {
    font-family: var(--font-heading);
    font-weight: 400;
    white-space: nowrap;
    opacity: 0.7;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .tag-entry:hover .tag-name,
  .tag-entry:focus-visible .tag-name {
    color: var(--color-accent);
    opacity: 1;
  }

  /* Dot leader between name and count */
  .tag-leader {
    flex: 1;
    border-bottom: 2px dotted var(--color-border);
    min-width: 2rem;
    align-self: baseline;
    margin-bottom: 0.3em;
    transition: opacity 0.25s ease;
  }

  /* Post count on the right */
  .tag-count {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    min-width: 1.5rem;
    text-align: right;
    transition: opacity 0.25s ease;
  }

  /* Latest post preview — hidden by default, shown on hover */
  .tag-preview {
    position: absolute;
    right: 0;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-style: italic;
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateX(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 55%;
    text-align: right;
    pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, var(--color-bg) 8%);
    padding-left: 1.5rem;
  }

  .tag-entry:hover .tag-leader,
  .tag-entry:focus-visible .tag-leader {
    opacity: 0;
  }

  .tag-entry:hover .tag-count,
  .tag-entry:focus-visible .tag-count {
    opacity: 0;
  }

  .tag-entry:hover .tag-preview,
  .tag-entry:focus-visible .tag-preview {
    opacity: 1;
    transform: translateX(0);
  }

  /* Focus ring for keyboard navigation */
  .tag-entry:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* On small screens, hide preview since no hover */
  @media (max-width: 640px) {
    .tag-preview {
      display: none;
    }

    .tag-entry:hover .tag-leader,
    .tag-entry:focus-visible .tag-leader {
      opacity: 1;
    }

    .tag-entry:hover .tag-count,
    .tag-entry:focus-visible .tag-count {
      opacity: 1;
    }
  }
</style>
