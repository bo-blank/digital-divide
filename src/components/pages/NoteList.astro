---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../Container.astro';
import PageBanner from '../PageBanner.astro';
import { entrySlug, getPublishedNotes } from '../../lib/content-utils';
import { formatDate } from '../../lib/format-date';
import { getTagLabeller } from '../../lib/tag-labels';
import type { Lang } from '../../i18n/config';
import { localePath } from '../../i18n/routing';
import { useTranslations } from '../../i18n/ui';

/** The notes archive, shared by /notes and /de/notes. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);
const tagLabel = await getTagLabeller(lang);

const notes = await getPublishedNotes(lang);

function getPreview(body: string, maxLength = 150): string {
  const text = body
    .replace(/^---[\s\S]*?---\s*/m, '')  // strip frontmatter if present
    .replace(/!\[.*?\]\(.*?\)/g, '')       // strip images
    .replace(/\[([^\]]+)\]\(.*?\)/g, '$1') // links → text
    .replace(/#{1,6}\s+/g, '')             // strip headings
    .replace(/[*_~`>]/g, '')               // strip emphasis/quotes
    .replace(/^-\s+/gm, '')               // strip list markers
    .replace(/\n+/g, ' ')                 // collapse newlines
    .trim();
  return text.length > maxLength ? text.slice(0, maxLength).trimEnd() + '…' : text;
}
---

<BaseLayout title={t('notes.title')} lang={lang} description={t('notes.description')}>
  {/* The default `banner` variant is a text-only strip — it never renders
      src/alt, so the image props that used to sit here were dead weight. */}
  <PageBanner>
    <h1 class="text-3xl sm:text-4xl font-heading font-normal tracking-tight text-accent-content">
      {t('notes.title')}
    </h1>
    <p class="mt-3 text-base text-accent-content/90">
      {t('notes.tagline')}
    </p>
  </PageBanner>

  <section class="py-12 sm:py-16">
    <Container>

      {notes.length > 0 ? (
        <div class="space-y-8">
          {notes.map((note) => (
            <article
              class="group note-accent border-l-2 pl-6"
              data-note-color={note.data.color}
            >
              <a href={localePath(lang, `/notes/${entrySlug(note.id)}`)} class="block">
                {note.data.draft && (
                  <span class="mb-2 inline-block rounded bg-secondary/20 px-2 py-1 text-xs font-medium text-secondary">
                    {t('notes.draft')}
                  </span>
                )}
                {note.data.title ? (
                  <h2 class="text-xl font-semibold group-hover:text-primary transition-colors">
                    {note.data.title}
                  </h2>
                ) : (
                  <p class="text-base-content group-hover:text-primary transition-colors">
                    {t('notes.viewNote')}
                  </p>
                )}
                <time
                  datetime={note.data.publishDate.toISOString()}
                  class="mt-2 block text-sm text-base-content/70"
                >
                  {formatDate(note.data.publishDate, lang)}
                </time>
                {note.body && (
                  <p class="mt-2 text-sm text-base-content/70 line-clamp-2">
                    {getPreview(note.body)}
                  </p>
                )}
              </a>
              {note.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {note.data.tags.map((tag) => (
                    <a href={localePath(lang, `/tags/${tag}`)} class="tag">
                      {tagLabel(tag)}
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="text-base-content/70 text-center py-12">
          {t('notes.empty')}
        </p>
      )}
    </Container>
  </section>
</BaseLayout>
