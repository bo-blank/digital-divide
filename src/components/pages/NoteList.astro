---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../Container.astro';
import PageBanner from '../PageBanner.astro';
import { entrySlug, getPublishedNotes } from '../../lib/content-utils';
import { formatDate } from '../../lib/format-date';
import { getTagLabeller } from '../../lib/tag-labels';
import type { Lang } from '../../i18n/config';
import { localePath } from '../../i18n/routing';
import { useTranslations } from '../../i18n/ui';

/** The notes archive, shared by /notes and /de/notes. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);
const tagLabel = await getTagLabeller(lang);

const notes = await getPublishedNotes(lang);

function getPreview(body: string, maxLength = 260): string {
  const text = body
    .replace(/^---[\s\S]*?---\s*/m, '')  // strip frontmatter if present
    .replace(/!\[.*?\]\(.*?\)/g, '')       // strip images
    .replace(/\[([^\]]+)\]\(.*?\)/g, '$1') // links → text
    .replace(/#{1,6}\s+/g, '')             // strip headings
    .replace(/[*_~`>]/g, '')               // strip emphasis/quotes
    .replace(/^-\s+/gm, '')               // strip list markers
    .replace(/\n+/g, ' ')                 // collapse newlines
    .trim();
  return text.length > maxLength ? text.slice(0, maxLength).trimEnd() + '…' : text;
}
---

<BaseLayout title={t('notes.title')} lang={lang} description={t('notes.description')}>
  {/* The default `banner` variant is a text-only strip — it never renders
      src/alt, so the image props that used to sit here were dead weight. */}
  <PageBanner>
    <h1 class="text-3xl sm:text-4xl font-heading font-normal tracking-tight text-accent-content">
      {t('notes.title')}
    </h1>
    <p class="mt-3 text-base text-accent-content/90">
      {t('notes.tagline')}
    </p>
  </PageBanner>

  <section class="py-12 sm:py-16">
    <Container>

      {notes.length > 0 ? (
        <div class="grid items-start gap-x-8 gap-y-12 pt-4 sm:grid-cols-2 lg:grid-cols-3">
          {notes.map((note) => (
            <article class="note-card" data-note-color={note.data.color}>
              {note.data.draft && (
                <span class="note-badge">{t('notes.draft')}</span>
              )}
              {/* One stretched link per card (see .note-card-link) keeps a single
                  tab stop per note while the tags stay separately clickable.
                  An untitled note gets its fallback title for assistive tech
                  only — visibly, the preview is the note. */}
              <h2 class="note-card-title">
                <a href={localePath(lang, `/notes/${entrySlug(note.id)}`)} class="note-card-link">
                  {note.data.title ?? (
                    <span class="sr-only">
                      {t('notes.untitled', { date: formatDate(note.data.publishDate, lang) })}
                    </span>
                  )}
                </a>
              </h2>
              {note.body && (
                <p class="note-card-preview">{getPreview(note.body)}</p>
              )}
              <div class="note-card-meta">
                <time datetime={note.data.publishDate.toISOString()}>
                  {formatDate(note.data.publishDate, lang)}
                </time>
                {note.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {note.data.tags.map((tag) => (
                      <a href={localePath(lang, `/tags/${tag}`)} class="tag">
                        {tagLabel(tag)}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-base-content/70 text-center py-12">
          {t('notes.empty')}
        </p>
      )}
    </Container>
  </section>
</BaseLayout>
