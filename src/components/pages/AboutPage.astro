---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../Container.astro';
import PageBanner from '../PageBanner.astro';
import { mdxComponents } from '../mdx/components';
import { localeEntryId } from '../../lib/content-utils';
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import aboutImage from '../../assets/covers/divide-gap-person.jpg';

/**
 * The /about body, shared by /about and /de/about.
 *
 * The prose lives in src/content/pages/{about,de/about}.mdx so it can be
 * edited in Keystatic (singletons.about / aboutDe). This file owns the chrome
 * only — including the hero photograph, which is a fixed asset the layout
 * positions by hand rather than something an editor swaps.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);

const entryId = localeEntryId(lang, 'about');
const page = await getEntry('pages', entryId);

if (!page) {
  throw new Error(
    `Missing src/content/pages/${entryId}.mdx — /about renders its prose from the \`pages\` collection.`
  );
}

const { Content } = await render(page);
---

<BaseLayout title={page.data.title} lang={lang} description={page.data.description}>
  <PageBanner>
    <h1 class="text-3xl sm:text-4xl font-heading font-normal tracking-tight text-accent-content">
      {page.data.title}
    </h1>
    {page.data.tagline && (
      <p class="text-accent-content/90">{page.data.tagline}</p>
    )}
  </PageBanner>

  <section class="py-12 sm:py-16">
    <Container narrow>
      <div class="w-full h-64 sm:h-80 mb-8 overflow-hidden relative bg-base-300 animate-pulse">
        <Image
          src={aboutImage}
          alt={t('about.heroAlt')}
          class="absolute bottom-0 w-full h-[200%] object-cover object-bottom"
          loading="eager"
          onload="this.parentElement.classList.remove('bg-base-300', 'animate-pulse')"
        />
      </div>
      <div class="prose prose-lg max-w-none">
        {page.data.lead && (
          <p class="text-xl text-base-content/70 leading-relaxed">
            {page.data.lead}
          </p>
        )}
        <Content components={mdxComponents} />
      </div>
    </Container>
  </section>
</BaseLayout>
