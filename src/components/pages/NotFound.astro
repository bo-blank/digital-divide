---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../Container.astro';
import { entrySlug, getPublishedPosts } from '../../lib/content-utils';
import { locales, localeMeta, type Lang } from '../../i18n/config';
import { localePath } from '../../i18n/routing';
import { useTranslations } from '../../i18n/ui';

/** The 404 body, shared by /404 and /de/404. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);

const recentPosts = (await getPublishedPosts(lang)).slice(0, 3);

// A static host serves the root /404.html for every miss, including ones under
// /de/ (see the note in CLAUDE.md — routing those to /de/404.html needs a host
// rule). Until that is wired up, offering the other language's home page here
// is what stops a German reader who mistypes a URL from landing on an
// English-only dead end.
const otherLocales = locales.filter((locale) => locale !== lang);
---

<BaseLayout title={t('notFound.title')} lang={lang} description={t('notFound.description')}>
  <section class="py-16 sm:py-24">
    <Container narrow>
      <header class="mb-10">
        <p class="font-ui text-sm uppercase tracking-widest text-base-content/60">
          {t('notFound.kicker')}
        </p>
        <h1 class="mt-3">{t('notFound.heading')}</h1>
        <p class="mt-4 text-lg text-base-content/70">
          {t('notFound.body')}
        </p>
      </header>

      <div class="flex flex-wrap gap-3">
        <a href={localePath(lang, '/')} class="btn btn-primary">{t('notFound.goHome')}</a>
        <a href={localePath(lang, '/essays')} class="btn btn-outline btn-primary">
          {t('notFound.browseEssays')}
        </a>
        {otherLocales.map((locale) => (
          <a
            href={localePath(locale, '/')}
            class="btn btn-ghost"
            hreflang={localeMeta[locale].htmlLang}
            lang={localeMeta[locale].htmlLang}
          >
            {localeMeta[locale].label}
          </a>
        ))}
      </div>

      {recentPosts.length > 0 && (
        <div class="mt-14 border-t border-base-300 pt-8">
          <h2 class="text-xl">{t('notFound.recentEssays')}</h2>
          <ul class="mt-4 space-y-3">
            {recentPosts.map((post) => (
              <li>
                <a
                  href={localePath(lang, `/essays/${entrySlug(post.id)}`)}
                  class="text-primary hover:underline"
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>
