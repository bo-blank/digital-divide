---
interface Props {
  type?: 'info' | 'warning' | 'success' | 'error';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const typeStyles = {
  info: 'border-tertiary bg-tertiary/10',
  warning: 'border-secondary bg-secondary/10',
  success: 'border-accent bg-accent/10',
  error: 'border-red-400 bg-red-50 dark:bg-red-900/20',
};

const iconPaths = {
  info: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  warning: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z',
  success: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  error: 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z',
};
---

<aside
  class={`my-6 rounded-lg border-l-4 p-4 ${typeStyles[type]}`}
  role="note"
  aria-label={title || `${type} callout`}
>
  <div class="flex items-start gap-3">
    <svg
      class="mt-0.5 h-5 w-5 flex-shrink-0 opacity-70"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d={iconPaths[type]}
      />
    </svg>
    <div class="flex-1">
      {title && (
        <p class="mb-1 font-semibold">{title}</p>
      )}
      <div class="prose-sm">
        <slot />
      </div>
    </div>
  </div>
</aside>
