---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format-date';

interface Props {
  posts: CollectionEntry<'blog'>[];
  title?: string;
}

const { posts, title = 'You might also like' } = Astro.props;
---

{posts.length > 0 && (
  <aside class="related-posts">
    <h2 class="text-lg font-heading font-medium mb-6">{title}</h2>
    <div class="grid gap-4 grid-cols-2 sm:grid-cols-3 sm:gap-6">
      {posts.map((post) => (
        <article class="related-post group">
          {post.data.coverImage ? (
            <a href={`/blog/${post.id}`} class="block aspect-video overflow-hidden rounded-lg mb-3">
              <Image
                src={post.data.coverImage.src}
                alt={post.data.coverImage.alt}
                width={400}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </a>
          ) : (
            <a href={`/blog/${post.id}`} class="block aspect-video overflow-hidden rounded-lg mb-3 bg-primary/10 flex items-center justify-center">
              <span class="text-primary/30 text-2xl font-heading">DD</span>
            </a>
          )}
          <a href={`/blog/${post.id}`} class="block">
            <h3 class="font-heading font-medium text-base leading-snug group-hover:text-primary transition-colors">
              {post.data.title}
            </h3>
          </a>
          <time
            datetime={post.data.publishDate.toISOString()}
            class="block mt-1 text-xs text-base-content/60"
          >
            {formatDate(post.data.publishDate, 'short')}
          </time>
        </article>
      ))}
    </div>
  </aside>
)}

<style>
  .related-posts {
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }
</style>
