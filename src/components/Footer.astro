---
import type { Lang } from '../i18n/config';
import { localePath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);

const currentYear = new Date().getFullYear();
const p = (path: string) => localePath(lang, path);
---

<footer class="border-t border-base-300 bg-base-200">
  <div class="mx-auto max-w-6xl px-4">
    <div class="footer sm:footer-horizontal text-base-content py-10">
      {/* h2, not h6: these are the first headings under the page's h1 in
          document order, so h6 skipped h2-h5 on all 40 pages. Each nav takes
          its accessible name from its own heading. */}
      <nav aria-labelledby="footer-explore">
        <h2 id="footer-explore" class="footer-title">{t('footer.explore')}</h2>
        <a href={p('/essays')} class="link link-hover">{t('footer.essays')}</a>
        <a href={p('/notes')} class="link link-hover">{t('footer.notes')}</a>
        <a href={p('/tags')} class="link link-hover">{t('footer.topics')}</a>
        <a href={p('/series')} class="link link-hover">{t('footer.series')}</a>
        {/* Each locale gets its own feed — a reader who subscribes from the
            German site should not start receiving English essays. */}
        <a href={p('/rss.xml')} class="link link-hover">{t('footer.rss')}</a>
      </nav>
      <nav aria-labelledby="footer-about">
        <h2 id="footer-about" class="footer-title">{t('footer.about')}</h2>
        <a href={p('/about')} class="link link-hover">{t('footer.aboutUs')}</a>
        <a href="mailto:hello@digitaldivide.com" class="link link-hover">{t('footer.contact')}</a>
      </nav>
      <nav aria-labelledby="footer-legal">
        <h2 id="footer-legal" class="footer-title">{t('footer.legal')}</h2>
        <a href={p('/privacy')} class="link link-hover">{t('footer.privacy')}</a>
      </nav>
      <form action={p('/subscribe')} method="get">
        <h2 class="footer-title">{t('footer.newsletter')}</h2>
        <fieldset class="w-full max-w-80">
          {/* Was a <label> with no `for`, which both left it orphaned and
              competed with the input's own aria-label. As a description it
              supplements the accessible name instead of fighting it. */}
          <p id="footer-newsletter-hint" class="text-sm">{t('footer.newsletterHint')}</p>
          <div class="join mt-2">
            <input
              type="email"
              name="email"
              placeholder={t('footer.emailPlaceholder')}
              class="input input-bordered join-item"
              aria-label={t('footer.emailLabel')}
              aria-describedby="footer-newsletter-hint"
            />
            <button type="submit" class="btn btn-primary join-item">{t('footer.subscribe')}</button>
          </div>
        </fieldset>
      </form>
    </div>

    <div class="border-t border-base-300 py-4">
      <p class="text-sm text-base-content/70">{t('site.rights', { year: currentYear })}</p>
    </div>
  </div>
</footer>
