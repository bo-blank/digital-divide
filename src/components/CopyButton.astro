---
/**
 * Attaches a copy-to-clipboard button to every <pre> on the page.
 *
 * Renders no markup of its own — the buttons are created at runtime by the
 * script below and appended to each code block. Include this component once
 * per page that can contain code (see BlogPostLayout).
 *
 * Styling lives in global.css (.copy-code-btn); it cannot live in a scoped
 * <style> here because Astro's scoping relies on a data-astro-cid-* attribute
 * that JS-created elements never receive.
 */
---

<script>
  function initCopyButtons() {
    // Find all code blocks and add copy buttons
    document.querySelectorAll('pre:not(.has-copy-btn)').forEach((pre) => {
      if (!(pre instanceof HTMLElement)) return;
      pre.classList.add('has-copy-btn');
      pre.style.position = 'relative';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code-btn';
      button.setAttribute('aria-label', 'Copy code to clipboard');
      button.setAttribute('title', 'Copy code');
      button.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="copy-icon">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="check-icon hidden">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      `;

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code?.textContent || pre.textContent || '';

        try {
          await navigator.clipboard.writeText(text);
          const copyIcon = button.querySelector('.copy-icon');
          const checkIcon = button.querySelector('.check-icon');

          if (copyIcon && checkIcon) {
            copyIcon.classList.add('hidden');
            checkIcon.classList.remove('hidden');

            setTimeout(() => {
              copyIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy code:', err);
        }
      });

      pre.appendChild(button);
    });
  }

  // Run on page load
  initCopyButtons();

  // Re-run on page transitions (View Transitions API)
  document.addEventListener('astro:page-load', initCopyButtons);
</script>
