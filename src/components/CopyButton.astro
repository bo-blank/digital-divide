---
/**
 * Copy to clipboard button for code blocks.
 * Should be positioned absolutely within a relative-positioned code block container.
 */
---

<button
  type="button"
  class="copy-code-btn"
  aria-label="Copy code to clipboard"
  title="Copy code"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="copy-icon">
    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
  </svg>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="check-icon hidden">
    <polyline points="20 6 9 17 4 12"/>
  </svg>
</button>

<style>
  .copy-code-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    background-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    opacity: 0;
    transition: opacity 0.2s, background-color 0.2s;
    cursor: pointer;
    border: none;
  }

  :global(.astro-code):hover .copy-code-btn,
  :global(pre):hover .copy-code-btn,
  .copy-code-btn:focus-visible {
    opacity: 1;
  }

  .copy-code-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
    color: white;
  }

  .copy-code-btn:focus-visible {
    outline: 2px solid var(--color-primary, #A8BCA1);
    outline-offset: 2px;
  }

  .hidden {
    display: none;
  }
</style>

<script>
  function initCopyButtons() {
    // Find all code blocks and add copy buttons
    document.querySelectorAll('pre:not(.has-copy-btn)').forEach((pre) => {
      pre.classList.add('has-copy-btn');
      pre.style.position = 'relative';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code-btn';
      button.setAttribute('aria-label', 'Copy code to clipboard');
      button.setAttribute('title', 'Copy code');
      button.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="copy-icon">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="check-icon hidden">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      `;

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code?.textContent || pre.textContent || '';

        try {
          await navigator.clipboard.writeText(text);
          const copyIcon = button.querySelector('.copy-icon');
          const checkIcon = button.querySelector('.check-icon');

          if (copyIcon && checkIcon) {
            copyIcon.classList.add('hidden');
            checkIcon.classList.remove('hidden');

            setTimeout(() => {
              copyIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy code:', err);
        }
      });

      pre.appendChild(button);
    });
  }

  // Run on page load
  initCopyButtons();

  // Re-run on page transitions (View Transitions API)
  document.addEventListener('astro:page-load', initCopyButtons);
</script>
